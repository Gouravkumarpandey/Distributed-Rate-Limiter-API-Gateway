{
  "name": "distributed-api-gateway",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["frontend", "backend", "test-services/*", "packages/*"],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:gateway": "npm --workspace backend run dev",
    "dev:user": "npm --workspace test-services/user-service run dev",
    "dev:payment": "npm --workspace test-services/payment-service run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:dashboard": "npm --workspace frontend run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": { "node": ">=20" }
}
